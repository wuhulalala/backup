    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "ssp",
            "type": "python",
            "request": "launch",
            "program": "/root/work/2SSP/main.py",
            "console": "integratedTerminal",
            "args": [
                "--model",
                "/bigdata/Qwen2.5-VL-7B-Instruct",
                "--pruning_method",
                "2ssp",
                "--sparsity_rate",
                "0.5"
            ]
        },
    ]
}