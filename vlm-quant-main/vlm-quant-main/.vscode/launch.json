{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Attach to Edge",
            "port": 9222,
            "request": "attach",
            "type": "msedge",
            "webRoot": "${workspaceFolder}"
        },
        {
            "name": "Python Debugger: Current File with Arguments",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": "${command:pickArgs}"
        },        
        {
            "name": "Debug VLM-quant run_vlm.sh",
            "type": "debugpy",
            "request": "launch",
            "python": "/root/work/flash_attention_from_scratch/.flashattn/bin/python",
            "program": "model_quant.py",
            "console": "integratedTerminal",
            "args": [
                "--model_name_or_path", "/bigdata/models/Qwen2.5-VL-7B-Instruct/",
                "--format", "nvfp",
                "--w_bits", "4",
                "--a_bits", "4",
                "--w_group_size", "16",
                "--a_group_size", "16",
                "--transform_class", "identity",
                "--w_observer", "minmax",
                "--quantization_order", "default",
                "--hadamard_group_size", "32",
                "--dataset_name_or_path", "cnn_dailymail",
                "--num_sequences", "1",
                "--sequence_length", "512",
                "--dtype", "auto",
                "--lm_eval_batch_size", "auto",
                "--save_path", "realquant_models/Qwen2.5-VL-7B-Instruct-quant-test",
                "--export_quantized_model", "realquant",
                "--cpu_offload_activations",
                "--cpu_offload_modules",
                "--fuse_global_scale",
                "--amp",
                "--model_type","vlm",
            ],
            "env": {
                "OMP_NUM_THREADS": "8",
                "PYTORCH_CUDA_ALLOC_CONF": "max_split_size_mb:128",
                "WANDB_PROJECT": "FPQuant",
                "WANDB_NAME": "/bigdata/models/Qwen2.5-VL-7B-Instruct/nvfp-w4-a4-GPTQ-identity-transform",
                "HF_HOME": "/bigdata/huggingface",
                "HF_ENDPOINT": "https://hf-mirror.com",
                "CUDA_VISIBLE_DEVICES": "4,5,6,7"
            },
            "justMyCode": false
        },
        {
            "name": "Debug test_infer_vlm.py in VLM-Quant",
            "type": "debugpy",
            "request": "launch",
            "program": "/bigdata/vlm-quant-main/src/test_infer_vlm.py",
            "console": "integratedTerminal",
            "env": {
                "HF_HOME": "/bigdata/huggingface",
                "HF_ENDPOINT": "https://hf-mirror.com",
                // "CUDA_VISIBLE_DEVICES": ""
            },
            "justMyCode": false
        }
    ]
}